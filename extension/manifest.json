{
  "manifest_version": 3,
  "name": "Second Look",
  "short_name": "Second Look",
  "version": "1.0.0",
  "description": "Your voice shopping copilot. Ask out loud: is this a good price, are the reviews real, is it cheaper elsewhere?",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Second Look",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "tabs", "activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.bestbuy.com/*",
        "*://*.walmart.com/*",
        "*://*.target.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
